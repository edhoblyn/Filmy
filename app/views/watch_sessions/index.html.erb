<h1>Your sessions</h1>

<%= link_to "New watch session", new_watch_session_path, class: "btn btn-primary" %>

<ul class="list-group">
  <% @watch_sessions.each do |ws| %>
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <%= link_to("Session ##{ws.id}", watch_session_path(ws)) %>
      <small class="text-muted"><%= ws.created_at.strftime("%Y-%m-%d") %></small>
    </li>
  <% end %>
</ul>
