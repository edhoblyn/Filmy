<div class="container mt-4">
  <h2><%= @watch_session.title %></h2>

  <hr>

  <div class="mb-4">
    <% @messages.each do |message| %>
      <div class="mb-2 <%= message.role == 'assistant' ? 'text-primary' : 'text-dark' %>">
        <strong><%= message.role.capitalize %>:</strong>
        <%= message.content %>
      </div>
    <% end %>
  </div>

  <hr>

  <%= form_with model: [@watch_session, @message] do |f| %>
    <div class="mb-3">
      <%= f.text_area :content, class: "form-control", placeholder: "Ask for a movie..." %>
    </div>

    <%= f.submit "Send", class: "btn btn-primary" %>
  <% end %>
</div>

<div class="row">
  <div class="col">
    <h1><%= @watch_session.name %></h1>
  </div>
  <div class="col-md-3">
    <h2>Chats</h2>
    <div class="mb-4">
      <% if @chats.any? %>
        <ul>
          <% @chats.each do |chat| %>
            <li><%= link_to chat.title, chat_path(chat) %></li>
          <% end %>
        </ul>
      <% else %>
        There are no chats yet.
      <% end %>
    </div>
    <%= button_to "New chat", watch_session_chats_path(@watch_session), class: "btn btn-primary" %>
  </div>
</div>
